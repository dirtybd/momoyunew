          "title": "核对译文ID和完整性",
          "desc": "",
          "code_language": "javascript",
          "code": "function main({text,task}){const input=JSON.parse(task);const clean=String(text||'').trim().replace(/^(?:<think>[\\s\\S]*?<\\/think>\\s*)+/i,'').replace(/^\\x60\\x60\\x60(?:json)?\\s*/i,'').replace(/\\s*\\x60\\x60\\x60$/,'');const v=JSON.parse(clean);if(!v||Object.keys(v).length!==1||!Array.isArray(v.translations)||v.translations.length!==input.items.length)throw Error('译文条目不完整');const ids=new Set(input.items.map(x=>x.id)),seen=new Set();for(const it of v.translations){if(!it||Object.keys(it).length!==2||!ids.has(it.id)||seen.has(it.id)||typeof it.text!=='string'||!it.text.trim()||it.text.length>24000||/<think>|<\\/think>/i.test(it.text))throw Error('译文无效');seen.add(it.id);}return {document_translations_json:JSON.stringify(v)};}",
