          "title": "解析翻译并准备审校",
          "desc": "",
          "selected": false,
          "code_language": "javascript",
          "code": "function main({text,tokens_json,source_json}){\n  const bad=m=>{throw Error(m)};\n  let tokens,sources;try{tokens=JSON.parse(tokens_json);sources=JSON.parse(source_json)}catch{bad('受保护标记映射无效')}\n  const clean=String(text||'').trim().replace(/^(?:<think>[\\s\\S]*?<\\/think>\\s*)+/i,'').replace(/^\\x60\\x60\\x60(?:json)?\\s*/i,'').replace(/\\s*\\x60\\x60\\x60$/,'');\n  let v;try{v=JSON.parse(clean)}catch{bad('翻译结果JSON无效')}\n  if(!v||!Array.isArray(v.translations))bad('缺少translations');\n  const map=new Map();\n  for(const item of v.translations){if(!item||typeof item.id!=='string'||typeof item.text!=='string'||!item.text.trim()||item.text.length>16000)bad('翻译条目无效');if(map.has(item.id))bad('翻译ID重复');map.set(item.id,item.text.trim());}\n  const ids=Object.keys(tokens);\n  if(ids.length!==map.size||ids.some(id=>!map.has(id)))bad('翻译条目不完整');\n  const items=ids.map(id=>{const src=sources[id];return {id,source:src.sourceText,sourceLanguage:src.sourceLanguage,targetLanguage:src.targetLanguage,translation:map.get(id)};});\n  const first=items[0];\n  return {validation_input:JSON.stringify({task:'validate_and_correct_industrial_translation',sourceLanguage:{code:first.sourceLanguage},targetLanguage:{code:first.targetLanguage},requirements:['Reject text written in any language other than the exact target language','Correct semantic or terminology errors','Return one canonical final translation per item','Preserve every __PORTALAI_TOKEN_NNN__ marker exactly'],items:items.map(x=>({id:x.id,source:x.source,translation:x.translation}))})};\n}",
