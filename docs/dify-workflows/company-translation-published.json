          "desc": "",
          "selected": false,
          "code_language": "javascript",
          "code": "function main({text,tokens_json}){\n  const bad=m=>{throw Error(m)};\n  let tokens;try{tokens=JSON.parse(tokens_json)}catch{bad('受保护标记映射无效')}\n  const clean=String(text||'').trim().replace(/^(?:<think>[\\s\\S]*?<\\/think>\\s*)+/i,'').replace(/^\\x60\\x60\\x60(?:json)?\\s*/i,'').replace(/\\s*\\x60\\x60\\x60$/,'');\n  let v;try{v=JSON.parse(clean)}catch{bad('审校结果JSON无效')}\n  if(!v||Object.keys(v).some(k=>k!=='validations')||!Array.isArray(v.validations))bad('缺少validations');\n  const map=new Map();\n  for(const item of v.validations){if(!item||typeof item.id!=='string'||typeof item.text!=='string'||!item.text.trim()||item.text.length>16000||item.valid!==true)bad('审校条目无效');if(map.has(item.id))bad('审校ID重复');map.set(item.id,item.text);}\n  const ids=Object.keys(tokens);\n  if(ids.length!==map.size||ids.some(id=>!map.has(id)))bad('审校条目不完整');\n  const restore=(id,value)=>{let out=String(value);for(let i=0;i<tokens[id].length;i++){const marker='__PORTALAI_TOKEN_'+String(i).padStart(3,'0')+'__';if(out.split(marker).length!==2)bad('受保护标记缺失：'+marker);out=out.split(marker).join(tokens[id][i]);}if(/__PORTALAI_TOKEN_\\d+__/.test(out))bad('审校返回了未知受保护标记');return out;};\n  return {translations_json:JSON.stringify({translations:ids.map(id=>({id,text:restore(id,map.get(id))}))})};\n}",
