          "title": "校验并保护工程标记",
          "desc": "",
          "selected": false,
          "code_language": "javascript",
          "code": "function main({payload_json}){\n  const bad=m=>{throw Error(m)};\n  if(typeof payload_json!=='string'||payload_json.length>60000)bad('输入过长');\n  let p;try{p=JSON.parse(payload_json)}catch{bad('输入JSON无效')}\n  if(!p||typeof p!=='object'||Array.isArray(p))bad('输入格式无效');\n  if(Object.keys(p).some(k=>!['items','glossary'].includes(k)))bad('不支持字段');\n  if(!Array.isArray(p.items)||p.items.length<1||p.items.length>24)bad('一次翻译1到24条');\n  const TOKEN=/(%[IQM](?:[BWD]?\\d+(?:\\.[0-7])?)|#[A-Za-z_][A-Za-z0-9_.]*|\\b[A-Za-z][A-Za-z0-9]*_[A-Za-z0-9_]+\\b|\\{\\{[^{}]+\\}\\}|\\{[A-Za-z0-9_.:-]+\\}|%[sdif]|<[^<>\\r\\n]+>)/gi;\n  const LANG={'zh-CN':'Simplified Chinese','zh-TW':'Traditional Chinese','en-US':'English','en-GB':'English','de-DE':'German','ja-JP':'Japanese','ko-KR':'Korean','fr-FR':'French','es-ES':'Spanish','pt-BR':'Portuguese','ru-RU':'Russian','it-IT':'Italian','tr-TR':'Turkish','pl-PL':'Polish','cs-CZ':'Czech','nl-NL':'Dutch'};\n  const tokens=Object.create(null),sources=Object.create(null),out=[];let total=0;\n  for(const it of p.items){\n    if(!it||typeof it!=='object'||Object.keys(it).some(k=>!['id','sourceText','sourceLanguage','targetLanguage'].includes(k)))bad('条目字段无效');\n    const id=it.id,text=it.sourceText;\n    if(typeof id!=='string'||!id||id.length>80||typeof text!=='string'||!text.trim()||text.length>4000)bad('条目内容无效');\n    if(typeof it.sourceLanguage!=='string'||!it.sourceLanguage||typeof it.targetLanguage!=='string'||!it.targetLanguage)bad('语言代码无效');\n    if(Object.hasOwn(tokens,id))bad('条目ID重复');\n    total+=text.length;\n    const list=[];\n    const protectedText=text.replace(TOKEN,token=>{const index=list.push(token)-1;return '__PORTALAI_TOKEN_'+String(index).padStart(3,'0')+'__';});\n    tokens[id]=list;\n    sources[id]={sourceLanguage:it.sourceLanguage,targetLanguage:it.targetLanguage,sourceText:protectedText};\n    out.push({id,sourceLanguage:it.sourceLanguage,targetLanguage:it.targetLanguage,text:protectedText});\n  }\n  if(total>12000)bad('一次最多12000字');\n  const first=out[0];\n  if(out.some(x=>x.sourceLanguage!==first.sourceLanguage||x.targetLanguage!==first.targetLanguage))bad('同一批次需使用相同语言对');\n  const payload={task:'translate_industrial_automation_text',sourceLanguage:{code:first.sourceLanguage,name:LANG[first.sourceLanguage]||first.sourceLanguage},targetLanguage:{code:first.targetLanguage,name:LANG[first.targetLanguage]||first.targetLanguage},requirements:['Every output must use the exact target language above','Use one canonical translation for repeated terminology','Preserve every __PORTALAI_TOKEN_NNN__ marker exactly'],items:out.map(x=>({id:x.id,text:x.text}))};\n  return {llm_input:JSON.stringify(payload),tokens_json:JSON.stringify(tokens),source_json:JSON.stringify(sources)};\n}",
