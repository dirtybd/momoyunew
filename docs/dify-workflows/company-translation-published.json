          "title": "检查文档翻译批次",
          "desc": "",
          "code_language": "javascript",
          "code": "function main({document_payload_json}){const p=JSON.parse(document_payload_json);if(!p||Array.isArray(p)||Object.keys(p).length!==2||!['zh-CN','zh-TW','en-US','en-GB','de-DE','ja-JP','ko-KR','fr-FR','es-ES','pt-BR','ru-RU','it-IT','tr-TR','pl-PL','cs-CZ','nl-NL'].includes(p.targetLanguage)||!Array.isArray(p.items)||!p.items.length||p.items.length>12)throw Error('文档批次无效');let total=0;const ids=new Set();for(const item of p.items){if(!item||Object.keys(item).length!==2||typeof item.id!=='string'||!item.id||item.id.length>160||ids.has(item.id)||typeof item.text!=='string'||!item.text.trim()||item.text.length>3000)throw Error('翻译条目无效');ids.add(item.id);total+=item.text.length;}if(total>3000)throw Error('批次最多3000字符');return {task:JSON.stringify(p)};}",
          "variables": [
            {
              "variable": "document_payload_json",
              "value_selector": [
                "start",
                "document_payload_json"
              ],
              "value_type": "string"
            }
          ],
          "outputs": {
            "task": {
              "type": "string",
              "children": null
            }
          }
        }
