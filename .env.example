# 仅本地监听。内网试用需要先补齐部署与访问控制。
HOST=127.0.0.1
PORT=8787
DATA_DIR=./data
# 已移除的 Agent 对话/草稿保留天数；已完成任务和积分记录不自动删除。
ARCHIVE_RETENTION_DAYS=7

# 新版 Agent 使用 /chat-messages 流式接口，密钥只放在服务端 .env。
# 留空密钥时为本地引导；填写后失败会报错，不会假装本地回答来自 AI。
DIFY_BASE_URL=http://127.0.0.1:8080/v1
DIFY_API_KEY=
DIFY_TIMEOUT_MS=600000

# 新分发入口：完成Dify配置和验收后设chatflow；legacy立即使用原Agent。
# 原DIFY_API_KEY保持，用作管理员回退和旧协议兼容。密钥均只在服务端。
DIFY_ENTRYPOINT=legacy
DIFY_CHATFLOW_BASE_URL=http://127.0.0.1:8080/v1
DIFY_CHATFLOW_API_KEY=
# 发布带专业助手视觉读取步骤的统一入口后再启用。
DIFY_AGENT_IMAGE_READING_ENABLED=false

# 智能匹配与待发布文字审核Workflow的专用密钥。未配置时匹配仅用标签规则，审核不放行。
DIFY_MATCHING_BASE_URL=http://127.0.0.1:8080/v1
DIFY_MATCHING_API_KEY=
# 修改线上模型/匹配策略时提升版本，使1小时能力判断缓存失效。
DIFY_MATCHING_POLICY_VERSION=semantic-care-v1
# off可暂停后台匹配定时器；发布及档案更新仍会触发即时匹配。
MATCHING_SCHEDULER=on

# 制卡工具与网页共用的随机密钥（至少32字符），只在服务端保存。
# 配好密钥后，npm run dev 会同时启动工具；生产另运行 npm run start:card-tool。
CARD_TOOL_SECRET=
CARD_TOOL_PORT=8792
CARD_TOOL_HOST=0.0.0.0

# 站内智能体推荐：AI 办公在无法完成任务时，从智能体广场公开目录推荐卡片。
# 门户接口无需登录；服务端缓存目录，门户不可用时沿用旧缓存。
AGENT_PORTAL_BASE_URL=http://10.37.26.35:5173
# 目录刷新间隔（毫秒，默认30分钟）
AGENT_CATALOG_TTL_MS=1800000
# 拉取目录超时（毫秒，默认10秒）
AGENT_CATALOG_TIMEOUT_MS=10000

# 站内改进意见邮件通知。未配置 SMTP 时，意见仍会保存并发送到管理员站内消息。
# Gmail 需要在 Google 账号中创建“应用专用密码”，不要把登录密码填在这里。
FEEDBACK_EMAIL=gdirtybd@gmail.com
FEEDBACK_SMTP_HOST=
FEEDBACK_SMTP_PORT=465
FEEDBACK_SMTP_SECURE=true
FEEDBACK_SMTP_USER=
FEEDBACK_SMTP_PASS=
FEEDBACK_SMTP_FROM=

# 钉钉群机器人（推荐）。安全设置选择“加签”时填写 SEC 开头的密钥。
# Webhook 形如 https://oapi.dingtalk.com/robot/send?access_token=...
FEEDBACK_DINGTALK_WEBHOOK=
FEEDBACK_DINGTALK_SECRET=

# 电气项目文本翻译工作流（同频）。密钥只保存在本机 .env，不要提交。
# 也可以复用 DIFY_BASE_URL；工作流入口固定为 /v1/workflows/run。
DIFY_TRANSLATION_BASE_URL=http://10.37.26.37/v1
DIFY_TRANSLATION_API_KEY=

# 电气专家 Agent：统一入口输入 /电气 或 /电气专家 时直接调用，绕过任务分发。
# 与电气项目文本翻译工作流是两个不同应用的 Key。
DIFY_ELECTRICAL_BASE_URL=http://10.37.26.37/v1
DIFY_ELECTRICAL_API_KEY=

# Dify 控制台登录（只用于 work/dify-sync 下的同步/改绑脚本，不是服务 API Key）。
# 优先于旧的 DST_* 变量；不要把真实密码写入仓库或提交。
DIFY_CONSOLE_BASE=http://10.37.26.37
DIFY_CONSOLE_EMAIL=
DIFY_CONSOLE_PASSWORD=

# 旧同步脚本使用的控制台账号变量，保持兼容；DIFY_CONSOLE_* 为空时才回退到这里。
DST_BASE=
DST_EMAIL=
DST_PASSWORD=

# 卡片封面风格（可选）：留空使用按关键词匹配的分类照片背景（匹配不到用通用）；
# 设为 icon 使用 Lucide 图标封面，设为 sketch 使用手绘场景（Rough.js）。都不需要改 Dify。
CARD_COVER_STYLE=
