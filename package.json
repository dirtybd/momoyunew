{
  "name": "momoyu-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "start:card-tool": "node --env-file-if-exists=.env scripts/card-tool.mjs",
    "icons:build": "node scripts/build-icon-catalog.mjs",
    "icons:preview": "node scripts/icon-cover-preview.mjs",
    "sketch:preview": "node scripts/sketch-preview.mjs",
    "test": "node --test server-tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@xmldom/xmldom": "^0.8.15",
    "busboy": "^1.6.0",
    "jszip": "^3.10.2",
    "nodemailer": "^10.4.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.4.624",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "roughjs": "^4.6.6",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5"
  }
}
