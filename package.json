{
  "name": "momoyu-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "start:card-tool": "node --env-file-if-exists=.env scripts/card-tool.mjs",
    "test": "node --test server-tests/*.test.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.5"
  }
}
